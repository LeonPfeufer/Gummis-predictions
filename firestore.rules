rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /matches/{id} {
      allow read: if true;
      // Community management: any signed-in friend can add matches and results.
      function validMatch() {
        let m = request.resource.data;
        return m.teamA is string && m.teamA.size() > 0 && m.teamA.size() <= 100
          && m.teamB is string && m.teamB.size() > 0 && m.teamB.size() <= 100 && m.teamA != m.teamB
          && m.series in ['BO1','BO3','BO5'] && m.season == 2026
          && m.startTime is timestamp && m.startTime >= timestamp.date(2026,1,1) && m.startTime < timestamp.date(2027,1,1);
      }
      function validResult() {
        let m = request.resource.data;
        return (m.result == null && m.resultScore == null && m.status == 'not_started')
          || (m.status == 'finished' && (
            (m.series == 'BO1' && ((m.result == 'A' && m.resultScore == '1-0') || (m.result == 'B' && m.resultScore == '0-1')))
            || (m.series == 'BO3' && ((m.result == 'A' && m.resultScore in ['2-0','2-1']) || (m.result == 'B' && m.resultScore in ['0-2','1-2'])))
            || (m.series == 'BO5' && ((m.result == 'A' && m.resultScore in ['3-0','3-1','3-2']) || (m.result == 'B' && m.resultScore in ['0-3','1-3','2-3'])))
          ));
      }
      allow create: if signedIn() && validMatch() && validResult()
        && request.resource.data.keys().hasOnly(['teamA','teamB','series','season','startTime','status','result','resultScore','createdAt'])
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && validMatch() && validResult()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['result','resultScore','status','manualOverride'])
        && request.resource.data.manualOverride == true;
      allow delete: if false;
    }
    match /users/{uid} {
      allow read: if true;
      function validProfile() { return signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.updatedAt == request.time; }
      allow create: if validProfile() && request.resource.data.keys().hasOnly(['uid','displayName','updatedAt']);
      allow update: if validProfile() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid','displayName','updatedAt']);
      allow delete: if false;
    }
    match /picks/{id} {
      function validPick() {
        let p = request.resource.data;
        let m = get(/databases/$(database)/documents/matches/$(p.matchId)).data;
        let score = p.exactScore;
        return p.keys().hasOnly(['userId','userName','matchId','pick','exactScore','updatedAt'])
          && p.userId == request.auth.uid && id == request.auth.uid + '_' + p.matchId
          && p.userName is string && p.userName.size() <= 100
          && p.pick in ['A','B'] && p.updatedAt == request.time
          && m.startTime > request.time
          && m.startTime >= timestamp.date(2026,1,1) && m.startTime < timestamp.date(2027,1,1)
          && m.get('result',null) == null && m.get('status','not_started') == 'not_started'
          && (score == null || (m.series == 'BO3' && ((p.pick == 'A' && score in ['2-0','2-1']) || (p.pick == 'B' && score in ['0-2','1-2'])))
            || (m.series == 'BO5' && ((p.pick == 'A' && score in ['3-0','3-1','3-2']) || (p.pick == 'B' && score in ['0-3','1-3','2-3']))));
      }
      allow read: if true;
      allow create, update: if signedIn() && validPick();
      allow delete: if false;
    }
    match /system/{id} { allow read: if true; allow write: if false; }
  }
}
